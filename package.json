{
  "name": "pdd-pwa-e2e-suite",
  "version": "2.0.0",
  "description": "Enterprise E2E Selenium Test Automation Framework for TradeMind PDD PWA (500+ Unique Test Cases)",
  "type": "module",
  "scripts": {
    "test": "mocha tests/selenium_500_testcases.spec.js --timeout 180000 --exit",
    "test:500": "mocha tests/selenium_500_testcases.spec.js --timeout 180000 --exit",
    "test:python": "python -m unittest tests/test_selenium.py",
    "generate:500": "node utilities/generate_500_spec_file.js",
    "report:excel": "python tests/generate_excel_report.py"
  },
  "dependencies": {
    "chai": "^5.1.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.22.0",
    "winston": "^3.13.0"
  }
}
